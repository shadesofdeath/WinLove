{
  "format": "winlove.catalog.tweaks",
  "version": 1,
  "_comment": "P11 Kayıt Defteri categories. apply=firstLogon: Windows resets the value during OOBE / first logon, so it is also re-applied after setup (SetupComplete.cmd / default-user RunOnce). Each tweak = registry writes in .reg value syntax, applied to the offline hives (HKCU = default user profile: applies to accounts created after setup).",
  "categories": [
    { "id": "privacy", "icon": "registry", "desc_tr": "Telemetri, reklam kimliği, konum, geri bildirim", "desc_en": "Telemetry, advertising ID, location, feedback" },
    { "id": "performance", "icon": "registry", "desc_tr": "Başlangıç gecikmesi, güç, arka plan uygulamaları", "desc_en": "Startup delay, power, background apps" },
    { "id": "appearance", "icon": "registry", "desc_tr": "Şeffaflık, animasyon, koyu tema varsayılanı", "desc_en": "Transparency, animation, dark theme default" },
    { "id": "explorer", "icon": "registry", "desc_tr": "Dosya uzantıları, gizli dosyalar, bağlam menüsü", "desc_en": "File extensions, hidden files, context menu" },
    { "id": "start", "icon": "registry", "desc_tr": "Öneriler, web araması, widget'lar", "desc_en": "Suggestions, web search, widgets" }
  ],
  "tweaks": [
    { "id": "telemetry-min", "category": "privacy", "tr": "Telemetriyi en düşük seviyeye al", "en": "Set telemetry to the minimum", "recommended": true,
      "writes": [ { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "value": "dword:00000000" } ] },
    { "id": "advertising-id", "apply": "firstLogon", "category": "privacy", "tr": "Reklam kimliğini kapat", "en": "Turn off the advertising ID", "recommended": true,
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo", "name": "Enabled", "value": "dword:00000000" },
                  { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\AdvertisingInfo", "name": "DisabledByGroupPolicy", "value": "dword:00000001" } ] },
    { "id": "location", "apply": "firstLogon", "category": "privacy", "tr": "Konum servisini kapat", "en": "Turn off location", "risk": "medium",
      "writes": [ { "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\location", "name": "Value", "value": "\"Deny\"" } ] },
    { "id": "activity-history", "category": "privacy", "tr": "Etkinlik geçmişini kapat", "en": "Turn off activity history", "recommended": true,
      "writes": [ { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "EnableActivityFeed", "value": "dword:00000000" },
                  { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "PublishUserActivities", "value": "dword:00000000" },
                  { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "UploadUserActivities", "value": "dword:00000000" } ] },
    { "id": "feedback", "category": "privacy", "tr": "Geri bildirim sıklığı: asla", "en": "Feedback frequency: never", "recommended": true,
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Siuf\\Rules", "name": "NumberOfSIUFInPeriod", "value": "dword:00000000" },
                  { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "DoNotShowFeedbackNotifications", "value": "dword:00000001" } ] },
    { "id": "tailored", "apply": "firstLogon", "category": "privacy", "tr": "Kişiye özel deneyimleri kapat", "en": "Turn off tailored experiences", "recommended": true,
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Privacy", "name": "TailoredExperiencesWithDiagnosticDataEnabled", "value": "dword:00000000" } ] },
    { "id": "inking", "category": "privacy", "tr": "El yazısı ve yazma kişiselleştirmesini kapat", "en": "Turn off inking and typing personalization",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\InputPersonalization", "name": "RestrictImplicitInkCollection", "value": "dword:00000001" },
                  { "key": "HKCU\\Software\\Microsoft\\InputPersonalization", "name": "RestrictImplicitTextCollection", "value": "dword:00000001" },
                  { "key": "HKCU\\Software\\Microsoft\\Personalization\\Settings", "name": "AcceptedPrivacyPolicy", "value": "dword:00000000" } ] },
    { "id": "error-reporting", "category": "privacy", "tr": "Windows Hata Raporlamayı kapat", "en": "Turn off Windows Error Reporting",
      "writes": [ { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Error Reporting", "name": "Disabled", "value": "dword:00000001" } ] },

    { "id": "startup-delay", "category": "performance", "tr": "Başlangıç uygulaması gecikmesini kaldır", "en": "Remove the startup app delay", "recommended": true,
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize", "name": "StartupDelayInMSec", "value": "dword:00000000" } ] },
    { "id": "hibernation", "category": "performance", "tr": "Hazırda bekletmeyi kapat (hiberfil.sys yok)", "en": "Turn off hibernation (no hiberfil.sys)", "risk": "medium",
      "writes": [ { "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power", "name": "HibernateEnabled", "value": "dword:00000000" },
                  { "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power", "name": "HibernateEnabledDefault", "value": "dword:00000000" } ] },
    { "id": "power-throttling", "category": "performance", "tr": "Güç kısıtlamasını (power throttling) kapat", "en": "Turn off power throttling", "risk": "medium",
      "writes": [ { "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power\\PowerThrottling", "name": "PowerThrottlingOff", "value": "dword:00000001" } ] },
    { "id": "game-dvr", "category": "performance", "tr": "Oyun DVR / arka plan kaydını kapat", "en": "Turn off Game DVR background recording", "recommended": true,
      "writes": [ { "key": "HKCU\\System\\GameConfigStore", "name": "GameDVR_Enabled", "value": "dword:00000000" },
                  { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR", "name": "AllowGameDVR", "value": "dword:00000000" } ] },
    { "id": "menu-delay", "category": "performance", "tr": "Menü açılma gecikmesi: 100 ms", "en": "Menu show delay: 100 ms",
      "writes": [ { "key": "HKCU\\Control Panel\\Desktop", "name": "MenuShowDelay", "value": "\"100\"" } ] },
    { "id": "background-apps", "category": "performance", "tr": "Arka plan uygulamalarını kapat", "en": "Turn off background apps", "risk": "medium",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\BackgroundAccessApplications", "name": "GlobalUserDisabled", "value": "dword:00000001" } ] },

    { "id": "dark-mode", "apply": "firstLogon", "category": "appearance", "tr": "Koyu tema varsayılan (uygulamalar ve sistem)", "en": "Dark theme by default (apps and system)",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "name": "AppsUseLightTheme", "value": "dword:00000000" },
                  { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "name": "SystemUsesLightTheme", "value": "dword:00000000" } ] },
    { "id": "transparency", "apply": "firstLogon", "category": "appearance", "tr": "Şeffaflık efektlerini kapat", "en": "Turn off transparency effects",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "name": "EnableTransparency", "value": "dword:00000000" } ] },
    { "id": "min-animate", "category": "appearance", "tr": "Pencere küçültme/büyütme animasyonunu kapat", "en": "Turn off minimize/maximize animation",
      "writes": [ { "key": "HKCU\\Control Panel\\Desktop\\WindowMetrics", "name": "MinAnimate", "value": "\"0\"" } ] },
    { "id": "accent-titlebar", "apply": "firstLogon", "category": "appearance", "tr": "Başlık çubuklarında vurgu rengi", "en": "Accent color on title bars",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\DWM", "name": "ColorPrevalence", "value": "dword:00000001" } ] },
    { "id": "no-spotlight", "apply": "firstLogon", "category": "appearance", "tr": "Windows Spotlight'ı kapat (kilit ekranı, masaüstü, öneriler)", "en": "Turn off Windows Spotlight (lock screen, desktop, suggestions)",
      "writes": [ { "key": "HKCU\\Software\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsSpotlightFeatures", "value": "dword:00000001" },
                  { "key": "HKCU\\Software\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableSpotlightCollectionOnDesktop", "value": "dword:00000001" },
                  { "key": "HKCU\\Software\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsSpotlightOnActionCenter", "value": "dword:00000001" },
                  { "key": "HKCU\\Software\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsSpotlightOnSettings", "value": "dword:00000001" },
                  { "key": "HKCU\\Software\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsSpotlightWindowsWelcomeExperience", "value": "dword:00000001" },
                  { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "RotatingLockScreenEnabled", "value": "dword:00000000" },
                  { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "RotatingLockScreenOverlayEnabled", "value": "dword:00000000" } ] },
    { "id": "no-spotlight-desktop-icon", "apply": "firstLogon", "category": "appearance", "tr": "Spotlight masaüstü simgesini kaldır", "en": "Remove the Spotlight desktop icon",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\HideDesktopIcons\\NewStartPanel", "name": "{2cc5ca98-6485-489a-920e-b3e88a6ccce3}", "value": "dword:00000001" } ] },
    { "id": "no-lockscreen-tips", "apply": "firstLogon", "category": "appearance", "tr": "Kilit ekranında ipuçlarını ve reklamları kapat", "en": "No tips or ads on the lock screen", "recommended": true,
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "RotatingLockScreenOverlayEnabled", "value": "dword:00000000" },
                  { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338387Enabled", "value": "dword:00000000" } ] },

    { "id": "file-ext", "category": "explorer", "tr": "Dosya uzantılarını göster", "en": "Show file extensions", "recommended": true,
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "HideFileExt", "value": "dword:00000000" } ] },
    { "id": "hidden-files", "category": "explorer", "tr": "Gizli dosyaları göster", "en": "Show hidden files",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Hidden", "value": "dword:00000001" } ] },
    { "id": "this-pc", "category": "explorer", "tr": "Gezgin \"Bu bilgisayar\" ile açılsın", "en": "Open File Explorer to This PC",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "LaunchTo", "value": "dword:00000001" } ] },
    { "id": "classic-context", "category": "explorer", "tr": "Klasik sağ tık menüsü (Windows 11)", "en": "Classic context menu (Windows 11)",
      "writes": [ { "key": "HKCU\\Software\\Classes\\CLSID\\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\\InprocServer32", "name": "", "value": "\"\"" } ] },
    { "id": "shortcut-suffix", "category": "explorer", "tr": "Kısayollarda \"- Kısayol\" ekini kaldır", "en": "No \"- Shortcut\" suffix on new shortcuts",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer", "name": "link", "value": "hex:00,00,00,00" } ] },
    { "id": "full-path", "category": "explorer", "tr": "Başlık çubuğunda tam yol", "en": "Full path in the title bar",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\CabinetState", "name": "FullPath", "value": "dword:00000001" } ] },
    { "id": "quick-access-recent", "category": "explorer", "tr": "Hızlı erişimde son dosyaları gösterme", "en": "No recent files in Quick Access",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer", "name": "ShowRecent", "value": "dword:00000000" },
                  { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer", "name": "ShowFrequent", "value": "dword:00000000" } ] },

    { "id": "web-search", "category": "start", "tr": "Başlat aramasında web sonuçlarını kapat", "en": "No web results in Start search", "recommended": true,
      "writes": [ { "key": "HKCU\\Software\\Policies\\Microsoft\\Windows\\Explorer", "name": "DisableSearchBoxSuggestions", "value": "dword:00000001" } ] },
    { "id": "widgets", "category": "start", "tr": "Widget'ları (Windows 10: Haberler ve ilgi alanları) kapat", "en": "Turn off widgets (Windows 10: News and interests)", "recommended": true,
      "writes": [ { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Dsh", "name": "AllowNewsAndInterests", "value": "dword:00000000" },
                  { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Feeds", "name": "EnableFeeds", "value": "dword:00000000" } ] },
    { "id": "taskbar-left", "apply": "firstLogon", "category": "start", "tr": "Görev çubuğu simgeleri solda", "en": "Taskbar icons on the left",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "TaskbarAl", "value": "dword:00000000" } ] },
    { "id": "consumer-features", "apply": "firstLogon", "category": "start", "tr": "Reklam uygulamalarını otomatik kurma", "en": "Don't auto-install promoted apps", "recommended": true,
      "writes": [ { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsConsumerFeatures", "value": "dword:00000001" },
                  { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SilentInstalledAppsEnabled", "value": "dword:00000000" },
                  { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "PreInstalledAppsEnabled", "value": "dword:00000000" },
                  { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "PreInstalledAppsEverEnabled", "value": "dword:00000000" },
                  { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "OemPreInstalledAppsEnabled", "value": "dword:00000000" },
                  { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SystemPaneSuggestionsEnabled", "value": "dword:00000000" },
                  { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338388Enabled", "value": "dword:00000000" } ] },
    { "id": "start-recommended", "apply": "firstLogon", "category": "start", "tr": "Başlat'ta önerileri ve son öğeleri gizle", "en": "Hide recommendations and recent items in Start",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Start_TrackDocs", "value": "dword:00000000" },
                  { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Start_IrisRecommendations", "value": "dword:00000000" } ] },
    { "id": "search-icon", "apply": "firstLogon", "category": "start", "tr": "Görev çubuğunda arama: yalnız simge", "en": "Taskbar search: icon only",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Search", "name": "SearchboxTaskbarMode", "value": "dword:00000001" } ] },
    { "id": "task-view", "apply": "firstLogon", "category": "start", "tr": "Görev görünümü düğmesini gizle", "en": "Hide the Task View button",
      "writes": [ { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "ShowTaskViewButton", "value": "dword:00000000" } ] }
  ]
}
